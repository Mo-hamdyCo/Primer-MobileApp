      "options": "Mobile Device"
    },
    {
      "fieldname": "endpoint",
      "label": "Endpoint Key",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "idempotency_key_hash",
      "label": "Idempotency Key Hash",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "index": 1
    },
    {
      "fieldname": "request_fingerprint",
      "label": "Request Fingerprint",
