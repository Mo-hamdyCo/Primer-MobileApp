      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "device",
      "label": "Device",
      "fieldtype": "Link",
      "options": "Mobile Device"
    },
    {
      "fieldname": "purpose",
      "label": "Upload Purpose",
      "fieldtype": "Select",
      "options": "checkin_photo\nleave_attachment",
      "default": "checkin_photo",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "file",
      "label": "File",
      "fieldtype": "Link",
      "options": "File",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "file_size",
      "label": "File Size (Bytes)",
      "fieldtype": "Int"
    },
    {
      "fieldname": "mime_type",
      "label": "Detected MIME Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "uploaded_at",
      "label": "Uploaded At",
      "fieldtype": "Datetime",
      "reqd": 1
    },
    {
      "fieldname": "expires_at",
      "label": "Expires At",
      "fieldtype": "Datetime",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "used",
      "label": "Used",
      "fieldtype": "Check",
      "default": "0",
