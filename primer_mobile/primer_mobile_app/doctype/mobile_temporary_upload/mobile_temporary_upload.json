{
  "actions": [],
  "doctype": "DocType",
  "module": "Primer Mobile App",
  "name": "Mobile Temporary Upload",
  "field_order": [
    "user",
    "device",
    "purpose",
    "file",
    "file_size",
    "mime_type",
