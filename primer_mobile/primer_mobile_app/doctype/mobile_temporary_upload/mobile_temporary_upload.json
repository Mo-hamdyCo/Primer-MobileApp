      "options": "DocType"
    },
    {
      "fieldname": "attached_to_name",
      "label": "Attached to Document Name",
      "fieldtype": "Data"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Mobile Admin",
      "read": 1,
      "write": 1
