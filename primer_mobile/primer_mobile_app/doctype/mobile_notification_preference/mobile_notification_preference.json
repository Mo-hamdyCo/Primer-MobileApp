{
  "actions": [],
  "doctype": "DocType",
  "module": "Primer Mobile App",
  "name": "Mobile Notification Preference",
  "field_order": [
    "user",
    "category",
    "enabled",
    "pref_version",
    "section_quiet",
    "quiet_hours_enabled",
    "quiet_hours_start",
    "quiet_hours_end",
    "timezone"
  ],
  "fields": [
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Link",
      "options": "Mobile Notification Category",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "pref_version",
      "label": "Preference Version",
      "fieldtype": "Int",
      "default": "1",
      "read_only": 1,
      "description": "Incremented on every update. Used for optimistic locking / conflict detection."
    },
    {
      "fieldname": "section_quiet",
      "label": "Quiet Hours",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "quiet_hours_enabled",
      "label": "Quiet Hours Enabled",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "quiet_hours_start",
      "label": "Quiet Hours Start",
      "fieldtype": "Time",
      "description": "Start of quiet hours (e.g. 22:00). Pushes (non-bypass) are suppressed after this time."
    },
    {
      "fieldname": "quiet_hours_end",
      "label": "Quiet Hours End",
      "fieldtype": "Time",
      "description": "End of quiet hours (e.g. 07:00). Supports cross-midnight intervals."
    },
    {
      "fieldname": "timezone",
      "label": "User Timezone",
      "fieldtype": "Data",
      "description": "IANA timezone string (e.g. Africa/Cairo). Falls back to site timezone."
    }
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Mobile Admin", "read": 1, "write": 1}
  ]
}
